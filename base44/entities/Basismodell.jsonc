{
  "name": "Basismodell",
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  },
  "type": "object",
  "properties": {
    "foto": {
      "type": "string",
      "title": "Foto"
    },
    "foto_freigestellt": {
      "type": "string",
      "title": "Foto freigestellt"
    },
    "zonen": {
      "type": "object",
      "title": "Körperzonen"
    },
    "seitenverhaeltnis": {
      "type": "number",
      "title": "Seitenverhältnis"
    },
    "ist_anker": {
      "type": "boolean",
      "title": "Anker",
      "default": false
    },
    "pose_beschreibung": {
      "type": "string",
      "title": "Pose"
    },
    "herkunft": {
      "type": "string",
      "title": "Herkunft",
      "enum": [
        "original_foto",
        "ki_generiert"
      ],
      "default": "original_foto"
    },
    "aktiv": {
      "type": "boolean",
      "title": "Aktiv",
      "default": true
    },
    "notiz": {
      "type": "string",
      "title": "Notiz"
    }
  }
}